# ============================================================
#  NutriAI 生产环境变量（复制为 .env 后填写，切勿提交到 Git）
# ============================================================

# 站点访问地址（邮件里的链接、CORS 同源判断都依赖它）
APP_BASE_URL=https://nutri.example.com
# 对外域名（Nginx 使用）
DOMAIN=nutri.example.com
# 联系人邮箱（Let's Encrypt 到期提醒）
ACME_EMAIL=admin@example.com

# ---- MySQL ----
MYSQL_DATABASE=nutriai
MYSQL_DB=nutriai
MYSQL_USER=nutriai
MYSQL_PASSWORD=请替换为强密码
MYSQL_ROOT_PASSWORD=请替换为更强的root密码
MYSQL_HOST=db
MYSQL_PORT=3306

# ---- AI（不填则使用离线 Mock 模式）----
AI_PROVIDER=openai-compat
AI_API_KEY=
AI_API_ENDPOINT=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# ---- 邮件（找回密码 / 邮箱验证；不填则跳过发送）----
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@nutri.example.com

# ---- 运行参数 ----
PORT=8080
SPRING_PROFILE=prod
# 先用 HTTP 验证时设为 false；配置 HTTPS 后改为 true 并重启 app
SESSION_COOKIE_SECURE=false
LOG_LEVEL=INFO
# 允许跨域来源（同源部署留空）
CORS_ORIGINS=
# 是否自动创建演示账号（生产建议 false）
DEMO_DATA=false
